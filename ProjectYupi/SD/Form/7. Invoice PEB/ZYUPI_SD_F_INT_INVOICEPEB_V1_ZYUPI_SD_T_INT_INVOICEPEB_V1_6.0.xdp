            <subform x="6.103mm" y="34.928mm" name="Sold" w="108.278mm" h="46.141mm">
               <bind match="dataRef" ref="$.BillingDocumentNode.BillToParty.BillingDocumentNode.BillToParty"/>
               <field name="Sold" access="readOnly" w="108.16mm" h="40.775mm" x="0.118mm" y="5.366mm">
                  <ui>
                     <textEdit multiLine="1"/>
                  </ui>
                  <font typeface="Arial" size="8pt"/>
                  <margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.5mm" rightInset="0.5mm"/>
                  <caption>
                     <para spaceAbove="0pt" spaceBelow="0pt"/>
                  </caption>
                  <para spaceAbove="0pt" spaceBelow="0pt"/>
                  <bind match="none"/>
                  <event activity="initialize" name="event__initialize">
                     <script contentType="application/x-javascript">
	var path = "xfa.datasets.data.Form.HeaderNode.";
	
	var CustName = xfa.resolveNode(path + "soldname");
	var street1 = xfa.resolveNode(path + "soldprefix1");
	var street2 = xfa.resolveNode(path + "soldprefix2");
	var street3 = xfa.resolveNode(path + "soldstreet");
	var street4 = xfa.resolveNode(path + "soldpsuffix1");
	var street5 = xfa.resolveNode(path + "soldpsuffix2");
	var street6 = xfa.resolveNode(path + "soldpostal");
	var street7 = xfa.resolveNode(path + "soldcity");
	var street8 = xfa.resolveNode(path + "soldcountry");
	
	var phone = xfa.resolveNode("xfa.datasets.data.Form.HeaderNode.soldphone");
	var fax = xfa.resolveNode("xfa.datasets.data.Form.HeaderNode.soldfax");
	var attn = xfa.resolveNode("xfa.datasets.data.Form.HeaderNode.soldattn");
	
	var result = "";
	
	//result += "Sold To Party : \n"
	if(CustName &amp;&amp; CustName.value) result += CustName.value + "\n";
	if(street1 &amp;&amp; street1.value) result += street1.value + "\n";
	if(street2 &amp;&amp; street2.value) result += street2.value + "\n";
	if(street3 &amp;&amp; street3.value) result += street3.value + "\n";
	if(street4 &amp;&amp; street4.value) result += street4.value + "\n";
	if(street5 &amp;&amp; street5.value) result += street5.value + "\n";
	if(street6 &amp;&amp; street6.value) result += street6.value + " ";
	if(street7 &amp;&amp; street7.value) result += street7.value + "\n";
	if(street8 &amp;&amp; street8.value) result += street8.value + "\n";
	
	if(phone &amp;&amp; phone.value ) 	 result += "Phone	: " + phone.value + "\n";
	if(fax &amp;&amp; fax.value ) 		 result += "Fax	: " + fax.value + "\n";	
	if(attn &amp;&amp; attn.value ) 	 result += "Attn	: " + attn.value + "\n";	

	this.rawValue = result;
</script>
                  </event>
               </field>
