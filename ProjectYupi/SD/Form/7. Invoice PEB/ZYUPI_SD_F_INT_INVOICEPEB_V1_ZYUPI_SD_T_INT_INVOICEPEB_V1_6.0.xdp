               <subform name="InWords" layout="table" columnWidths="42.041mm 41.347mm 30.48mm 82.45mm">
                  <border>
                     <edge presence="hidden"/>
                     <corner presence="hidden"/>
                  </border>
                  <subform layout="row" name="Row1" y="0mm">
                     <assist role="TR"/>
                     <field name="Cell1" h="5mm" access="readOnly">
                        <ui>
                           <textEdit/>
                        </ui>
                        <font typeface="Arial" size="8pt"/>
                        <margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.5mm" rightInset="0.5mm"/>
                        <para vAlign="middle"/>
                        <border>
                           <edge presence="hidden"/>
                           <corner thickness="0.1778mm" presence="hidden"/>
                        </border>
                        <event activity="initialize" name="event__initialize">
                           <script contentType="application/x-javascript">
	var temp = xfa.resolveNode("$record.HeaderNode.currency").value;
	//xfa.host.messageBox("Nodes kosong" + temp);
	var InWord = "";
	switch(temp){
		case "USD" :
			InWord = "Total Value in US Dollars : ";
			break;
		case "THB" :
			InWord = "Total Value in Thailnd Baht : ";
			break;
		case "MYR" :
			InWord = "Total Value in Malaysian Ringgit : ";
			break;
		case "VND" :
			InWord = "Total Value in Vietnamese Dong : ";
			break;
		case "PHP" :
			InWord = "Total Value in Philippine Peso : ";
			break;
		case "CNY" :
			InWord = "Total Value in Chinese Yuan Renminbi : ";
			break;
	}
	this.rawValue = InWord;
</script>
                        </event>
                        <bind match="none"/>
                     </field>
                     <field name="Inwords" colSpan="3" access="readOnly" minH="4mm">
                        <ui>
                           <textEdit multiLine="1"/>
                        </ui>
                        <font typeface="Arial" size="8pt"/>
                        <margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.5mm" rightInset="0.5mm"/>
                        <para vAlign="middle"/>
                        <border>
                           <edge presence="hidden"/>
                           <corner thickness="0.1778mm" presence="hidden"/>
                        </border>
                        <bind match="none"/>
                        <event activity="initialize" name="event__initialize">
                           <script>
	var price = xfa.resolveNode("Form.#subform.TableItems.Footer.Table3.GrandTotal.TotalPrice")
	var totalValue = xfa.resolveNode("Form.#subform.TableItems.Footer.GranTotal.Row1.ValGrandtotal") //GrandTotalValue
	//xfa.host.messageBox("TEST :" + totalValue );
	var n = 0
	var baseValue = 0
	
	// Jika totalValue kosong → pakai price
	if (totalValue == "" or totalValue == null or totalValue == "0") then
		baseValue = price
		//xfa.host.messageBox("Nodes kosong" )
	    n = Floor(Abs(price))   
	// Jika price kosong → pakai totalValue
	elseif (price == "" or price == null or price  == "0") then
		baseValue = totalValue
	    n = Floor(Abs(totalValue))
	// Dua-duanya ada → pakai totalValue
	else
		baseValue = totalValue
	    n = Floor(Abs(totalValue))
	endif
	
	//var n = Floor(Abs(totalValue))
	var decimalPart = Abs(baseValue) - n
	var decimal = Floor(decimalPart * 100 + 0.5) // Round to nearest cent
	var result = ""
	var word = ""
	var digit = 0
	
	// === BILLIONS ===
	if (n &gt;= 1000000000) then
	    var billions = Floor(n / 1000000000)
	    if (billions == 1) then result = Concat(result, "One Billion ")
	    elseif (billions == 2) then result = Concat(result, "Two Billion ")
	    elseif (billions == 3) then result = Concat(result, "Three Billion ")
	    elseif (billions == 4) then result = Concat(result, "Four Billion ")
	    elseif (billions == 5) then result = Concat(result, "Five Billion ")
	    elseif (billions == 6) then result = Concat(result, "Six Billion ")
	    elseif (billions == 7) then result = Concat(result, "Seven Billion ")
	    elseif (billions == 8) then result = Concat(result, "Eight Billion ")
	    elseif (billions == 9) then result = Concat(result, "Nine Billion ")
	    endif
	    n = Mod(n, 1000000000)
	endif
	
	// === MILLIONS (with hundreds) ===
	if (n &gt;= 1000000) then
	    var millions = Floor(n / 1000000)
	    if (millions &gt;= 100) then
	        var mHund = Floor(millions / 100)
	        if (mHund == 1) then result = Concat(result, "One Hundred ")
	        elseif (mHund == 2) then result = Concat(result, "Two Hundred ")
	        elseif (mHund == 3) then result = Concat(result, "Three Hundred ")
	        elseif (mHund == 4) then result = Concat(result, "Four Hundred ")
	        elseif (mHund == 5) then result = Concat(result, "Five Hundred ")
	        elseif (mHund == 6) then result = Concat(result, "Six Hundred ")
	        elseif (mHund == 7) then result = Concat(result, "Seven Hundred ")
	        elseif (mHund == 8) then result = Concat(result, "Eight Hundred ")
	        elseif (mHund == 9) then result = Concat(result, "Nine Hundred ")
	        endif
	        millions = Mod(millions, 100)
	    endif
	    if (millions &gt;= 20) then
	        var mPuluh = Floor(millions / 10)
	        var mSatuan = Mod(millions, 10)
	        if (mPuluh == 2) then word = "Twenty"
	        elseif (mPuluh == 3) then word = "Thirty"
	        elseif (mPuluh == 4) then word = "Forty"
	        elseif (mPuluh == 5) then word = "Fifty"
	        elseif (mPuluh == 6) then word = "Sixty"
	        elseif (mPuluh == 7) then word = "Seventy"
	        elseif (mPuluh == 8) then word = "Eighty"
	        elseif (mPuluh == 9) then word = "Ninety"
	        endif
	        result = Concat(result, word, " ")
	        if (mSatuan == 1) then result = Concat(result, "One ")
	        elseif (mSatuan == 2) then result = Concat(result, "Two ")
	        elseif (mSatuan == 3) then result = Concat(result, "Three ")
	        elseif (mSatuan == 4) then result = Concat(result, "Four ")
	        elseif (mSatuan == 5) then result = Concat(result, "Five ")
	        elseif (mSatuan == 6) then result = Concat(result, "Six ")
	        elseif (mSatuan == 7) then result = Concat(result, "Seven ")
	        elseif (mSatuan == 8) then result = Concat(result, "Eight ")
	        elseif (mSatuan == 9) then result = Concat(result, "Nine ")
	        endif
	    elseif (millions &gt;= 10 and millions &lt;= 19) then
	        if (millions == 10) then result = Concat(result, "Ten ")
	        elseif (millions == 11) then result = Concat(result, "Eleven ")
	        elseif (millions == 12) then result = Concat(result, "Twelve ")
	        elseif (millions == 13) then result = Concat(result, "Thirteen ")
	        elseif (millions == 14) then result = Concat(result, "Fourteen ")
	        elseif (millions == 15) then result = Concat(result, "Fifteen ")
	        elseif (millions == 16) then result = Concat(result, "Sixteen ")
	        elseif (millions == 17) then result = Concat(result, "Seventeen ")
	        elseif (millions == 18) then result = Concat(result, "Eighteen ")
	        elseif (millions == 19) then result = Concat(result, "Nineteen ")
	        endif
	    elseif (millions &gt; 0) then
	        if (millions == 1) then result = Concat(result, "One ")
	        elseif (millions == 2) then result = Concat(result, "Two ")
	        elseif (millions == 3) then result = Concat(result, "Three ")
	        elseif (millions == 4) then result = Concat(result, "Four ")
	        elseif (millions == 5) then result = Concat(result, "Five ")
	        elseif (millions == 6) then result = Concat(result, "Six ")
	        elseif (millions == 7) then result = Concat(result, "Seven ")
	        elseif (millions == 8) then result = Concat(result, "Eight ")
	        elseif (millions == 9) then result = Concat(result, "Nine ")
	        endif
	    endif
	    result = Concat(result, "Million ")
	    n = Mod(n, 1000000)
	endif
	
	// === THOUSANDS (with hundreds) ===
	if (n &gt;= 1000) then
	    var thousands = Floor(n / 1000)
	    if (thousands &gt;= 100) then
	        var tHund = Floor(thousands / 100)
	        if (tHund == 1) then result = Concat(result, "One Hundred ")
	        elseif (tHund == 2) then result = Concat(result, "Two Hundred ")
	        elseif (tHund == 3) then result = Concat(result, "Three Hundred ")
	        elseif (tHund == 4) then result = Concat(result, "Four Hundred ")
	        elseif (tHund == 5) then result = Concat(result, "Five Hundred ")
	        elseif (tHund == 6) then result = Concat(result, "Six Hundred ")
	        elseif (tHund == 7) then result = Concat(result, "Seven Hundred ")
	        elseif (tHund == 8) then result = Concat(result, "Eight Hundred ")
	        elseif (tHund == 9) then result = Concat(result, "Nine Hundred ")
	        endif
	        thousands = Mod(thousands, 100)
	    endif
	    if (thousands &gt;= 20) then
	        var tPuluh = Floor(thousands / 10)
	        var tSatuan = Mod(thousands, 10)
	        if (tPuluh == 2) then word = "Twenty"
	        elseif (tPuluh == 3) then word = "Thirty"
	        elseif (tPuluh == 4) then word = "Forty"
	        elseif (tPuluh == 5) then word = "Fifty"
	        elseif (tPuluh == 6) then word = "Sixty"
	        elseif (tPuluh == 7) then word = "Seventy"
	        elseif (tPuluh == 8) then word = "Eighty"
	        elseif (tPuluh == 9) then word = "Ninety"
	        endif
	        result = Concat(result, word, " ")
	        if (tSatuan == 1) then result = Concat(result, "One ")
	        elseif (tSatuan == 2) then result = Concat(result, "Two ")
	        elseif (tSatuan == 3) then result = Concat(result, "Three ")
	        elseif (tSatuan == 4) then result = Concat(result, "Four ")
	        elseif (tSatuan == 5) then result = Concat(result, "Five ")
	        elseif (tSatuan == 6) then result = Concat(result, "Six ")
	        elseif (tSatuan == 7) then result = Concat(result, "Seven ")
	        elseif (tSatuan == 8) then result = Concat(result, "Eight ")
	        elseif (tSatuan == 9) then result = Concat(result, "Nine ")
	        endif
	    elseif (thousands &gt;= 10 and thousands &lt;= 19) then
	        if (thousands == 10) then result = Concat(result, "Ten ")
	        elseif (thousands == 11) then result = Concat(result, "Eleven ")
	        elseif (thousands == 12) then result = Concat(result, "Twelve ")
	        elseif (thousands == 13) then result = Concat(result, "Thirteen ")
	        elseif (thousands == 14) then result = Concat(result, "Fourteen ")
	        elseif (thousands == 15) then result = Concat(result, "Fifteen ")
	        elseif (thousands == 16) then result = Concat(result, "Sixteen ")
	        elseif (thousands == 17) then result = Concat(result, "Seventeen ")
	        elseif (thousands == 18) then result = Concat(result, "Eighteen ")
	        elseif (thousands == 19) then result = Concat(result, "Nineteen ")
	        endif
	    elseif (thousands &gt; 0) then
	        if (thousands == 1) then result = Concat(result, "One ")
	        elseif (thousands == 2) then result = Concat(result, "Two ")
	        elseif (thousands == 3) then result = Concat(result, "Three ")
	        elseif (thousands == 4) then result = Concat(result, "Four ")
	        elseif (thousands == 5) then result = Concat(result, "Five ")
	        elseif (thousands == 6) then result = Concat(result, "Six ")
	        elseif (thousands == 7) then result = Concat(result, "Seven ")
	        elseif (thousands == 8) then result = Concat(result, "Eight ")
	        elseif (thousands == 9) then result = Concat(result, "Nine ")
	        endif
	    endif
	    result = Concat(result, "Thousand ")
	    n = Mod(n, 1000)
	endif
	
	// === HUNDREDS ===
	if (n &gt;= 100) then
	    digit = Floor(n / 100)
	    if (digit == 1) then result = Concat(result, "One Hundred ")
	    elseif (digit == 2) then result = Concat(result, "Two Hundred ")
	    elseif (digit == 3) then result = Concat(result, "Three Hundred ")
	    elseif (digit == 4) then result = Concat(result, "Four Hundred ")
	    elseif (digit == 5) then result = Concat(result, "Five Hundred ")
	    elseif (digit == 6) then result = Concat(result, "Six Hundred ")
	    elseif (digit == 7) then result = Concat(result, "Seven Hundred ")
	    elseif (digit == 8) then result = Concat(result, "Eight Hundred ")
	    elseif (digit == 9) then result = Concat(result, "Nine Hundred ")
	    endif
	    n = Mod(n, 100)
	endif
	
	// === TENS ===
	if (n &gt;= 20) then
	    digit = Floor(n / 10)
	    if (digit == 2) then word = "Twenty"
	    elseif (digit == 3) then word = "Thirty"
	    elseif (digit == 4) then word = "Forty"
	    elseif (digit == 5) then word = "Fifty"
	    elseif (digit == 6) then word = "Sixty"
	    elseif (digit == 7) then word = "Seventy"
	    elseif (digit == 8) then word = "Eighty"
	    elseif (digit == 9) then word = "Ninety"
	    endif
	    result = Concat(result, word, " ")
	    n = Mod(n, 10)
	elseif (n &gt;= 10 and n &lt;= 19) then
	    if (n == 10) then result = Concat(result, "Ten ")
	    elseif (n == 11) then result = Concat(result, "Eleven ")
	    elseif (n == 12) then result = Concat(result, "Twelve ")
	    elseif (n == 13) then result = Concat(result, "Thirteen ")
	    elseif (n == 14) then result = Concat(result, "Fourteen ")
	    elseif (n == 15) then result = Concat(result, "Fifteen ")
	    elseif (n == 16) then result = Concat(result, "Sixteen ")
	    elseif (n == 17) then result = Concat(result, "Seventeen ")
	    elseif (n == 18) then result = Concat(result, "Eighteen ")
	    elseif (n == 19) then result = Concat(result, "Nineteen ")
	    endif
	    n = 0
	endif
	
	// === ONES ===
	if (n &gt; 0) then
	    if (n == 1) then word = "One"
	    elseif (n == 2) then word = "Two"
	    elseif (n == 3) then word = "Three"
	    elseif (n == 4) then word = "Four"
	    elseif (n == 5) then word = "Five"
	    elseif (n == 6) then word = "Six"
	    elseif (n == 7) then word = "Seven"
	    elseif (n == 8) then word = "Eight"
	    elseif (n == 9) then word = "Nine"
	    endif
	    result = Concat(result, word, " ")
	endif
	
	// === DECIMAL PART (CENTS) - ONLY if greater than 0 ===
	if (decimal &gt; 0) then
	    result = Concat(result, "And ")
	    
	    // Tens place of cents
	    if (decimal &gt;= 20) then
	        var cTens = Floor(decimal / 10)
	        var cOnes = Mod(decimal, 10)
	        
	        if (cTens == 2) then result = Concat(result, "Twenty")
	        elseif (cTens == 3) then result = Concat(result, "Thirty")
	        elseif (cTens == 4) then result = Concat(result, "Forty")
	        elseif (cTens == 5) then result = Concat(result, "Fifty")
	        elseif (cTens == 6) then result = Concat(result, "Sixty")
	        elseif (cTens == 7) then result = Concat(result, "Seventy")
	        elseif (cTens == 8) then result = Concat(result, "Eighty")
	        elseif (cTens == 9) then result = Concat(result, "Ninety")
	        endif
	        
	        if (cOnes &gt; 0) then
	            result = Concat(result, " ")
	            if (cOnes == 1) then result = Concat(result, "One")
	            elseif (cOnes == 2) then result = Concat(result, "Two")
	            elseif (cOnes == 3) then result = Concat(result, "Three")
	            elseif (cOnes == 4) then result = Concat(result, "Four")
	            elseif (cOnes == 5) then result = Concat(result, "Five")
	            elseif (cOnes == 6) then result = Concat(result, "Six")
	            elseif (cOnes == 7) then result = Concat(result, "Seven")
	            elseif (cOnes == 8) then result = Concat(result, "Eight")
	            elseif (cOnes == 9) then result = Concat(result, "Nine")
	            endif
	        endif
	        
	    elseif (decimal &gt;= 10 and decimal &lt;= 19) then
	        if (decimal == 10) then result = Concat(result, "Ten")
	        elseif (decimal == 11) then result = Concat(result, "Eleven")
	        elseif (decimal == 12) then result = Concat(result, "Twelve")
	        elseif (decimal == 13) then result = Concat(result, "Thirteen")
	        elseif (decimal == 14) then result = Concat(result, "Fourteen")
	        elseif (decimal == 15) then result = Concat(result, "Fifteen")
	        elseif (decimal == 16) then result = Concat(result, "Sixteen")
	        elseif (decimal == 17) then result = Concat(result, "Seventeen")
	        elseif (decimal == 18) then result = Concat(result, "Eighteen")
	        elseif (decimal == 19) then result = Concat(result, "Nineteen")
	        endif
	        
	    else
	        if (decimal == 1) then result = Concat(result, "One")
	        elseif (decimal == 2) then result = Concat(result, "Two")
	        elseif (decimal == 3) then result = Concat(result, "Three")
	        elseif (decimal == 4) then result = Concat(result, "Four")
	        elseif (decimal == 5) then result = Concat(result, "Five")
	        elseif (decimal == 6) then result = Concat(result, "Six")
	        elseif (decimal == 7) then result = Concat(result, "Seven")
	        elseif (decimal == 8) then result = Concat(result, "Eight")
	        elseif (decimal == 9) then result = Concat(result, "Nine")
	        endif
	    endif
	    
	    result = Concat(result, " Cents")
	endif
	
	//xfa.host.messageBox("Isi field adalah: " &amp; result)
	$ = result
</script>
