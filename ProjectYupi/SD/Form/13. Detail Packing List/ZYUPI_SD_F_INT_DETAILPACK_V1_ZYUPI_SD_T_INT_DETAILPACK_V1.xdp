                  </border>
                  <event activity="ready" ref="$layout" name="group_gummy_layout_ready">
                     <script contentType="application/x-javascript">// Consolidate invoice rows by product category, using the ORIGINAL SAP item text.
// One output row per category: Gummy Candies, Gummy Candies Extrud, Marsmallow, Lolipop.
// Layout-ready can fire repeatedly: hidden duplicates are ignored on subsequent runs.
/*
var rows = this.resolveNodes("Items[*]");
var sums = {};

function valueNumber(v) {
    if (v === null || v === undefined || v === "") return 0;
    var s = String(v).replace(/\s/g, "");
    if (s.indexOf(",") &gt;= 0 &amp;&amp; s.indexOf(".") &gt;= 0) {
        if (s.lastIndexOf(",") &gt; s.lastIndexOf(".")) s = s.replace(/\./g, "").replace(",", ".");
        else s = s.replace(/,/g, "");
    } else if (/^-?\d{1,3}(,\d{3})+$/.test(s)) s = s.replace(/,/g, "");
    else if (s.indexOf(",") &gt;= 0) s = s.replace(",", ".");
    var n = Number(s);
    return isNaN(n) ? 0 : n;
}

function category(s) {
    s = String(s || "").replace(/^\s+|\s+$/g, "").toLowerCase();
    if (s === "") return "";
    // EXTRUD must be checked first, before generic Gummy Candies.
    if (s.indexOf("extrud") &gt;= 0) return "Gummy Candies Extrud";
    if (s.indexOf("marshmallow") &gt;= 0 || s.indexOf("marsmallow") &gt;= 0) return "Marsmallow";
    if (s.indexOf("lolipop") &gt;= 0 || s.indexOf("lollipop") &gt;= 0) return "Lolipop";
    return "Gummy Candies";
}

for (var i = 0; i &lt; rows.length; i++) {
    var r = rows.item(i);
    if (r.presence === "hidden") continue;
    var src = null;
    // Prefer the data node attached to the repeated row; its text is the original SAP value.
    if (r.dataNode !== null &amp;&amp; r.dataNode !== undefined) {
        src = r.dataNode.resolveNode("BillingDocumentItemText");
    }
    if (src === null) {
        src = xfa.resolveNode("xfa.datasets.data.Form.HeaderNode.ItemNode.Item[" + i + "].BillingDocumentItemText");
    }
    var raw = (src !== null &amp;&amp; src.value !== null) ? String(src.value) : "";
    if (raw === "") raw = String(r.resolveNode("Items").rawValue || "");
    var groupName = category(raw);
    r.resolveNode("Items").rawValue = groupName;
    if (groupName === "") continue;

    // Check whether this group has already appeared.
    if (sums[groupName] === undefined) {
        sums[groupName] = {first: r, qty: 0, price: 0, count: 0};
    }
    var g = sums[groupName];
    g.qty += valueNumber(r.resolveNode("Qty").rawValue);
    g.price += valueNumber(r.resolveNode("Cell6").rawValue);
    g.count++;
    if (r !== g.first) r.presence = "hidden";
}

for (var key in sums) {
    if (sums.hasOwnProperty(key) &amp;&amp; sums[key].count &gt; 1) {
        sums[key].first.resolveNode("Qty").rawValue = sums[key].qty;
        sums[key].first.resolveNode("Cell6").rawValue = Math.round(sums[key].price * 100) / 100;
    }
}

// Assign a consecutive display number only to the rows remaining visible.
// The original SAP NoItems numbering can have gaps after row consolidation.
var displayNo = 0;
for (var k = 0; k &lt; rows.length; k++) {
    var visibleRow = rows.item(k);
    if (visibleRow.presence === "hidden" || visibleRow.presence === "invisible") continue;
    var numberField = visibleRow.resolveNode("No");
    if (numberField !== null) {
        displayNo++;
        numberField.rawValue = displayNo;
    }
}
*/
</script>
                  </event>
