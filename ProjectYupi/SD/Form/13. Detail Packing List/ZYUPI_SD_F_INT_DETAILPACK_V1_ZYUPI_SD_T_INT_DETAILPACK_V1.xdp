      <variables>
         <script contentType="application/x-javascript" name="GlobalsCO">	
	// =======================================
	// Global Cache
	// =======================================
	var isLoaded = 0;
	
	var Z000 = "";
	var Z001 = "";
	var Z002 = "";
	var Z003 = "";
	var Z004 = "";
	
	
	// =======================================
	// Load semua Z-values sekali saja
	// =======================================
	function loadTextElements() {
	
	    if (isLoaded === 1) return;  // sudah pernah load
	
	    var nodes = xfa.resolveNodes("$record.BillingDocumentNode.TextElements.TextElementNode[*]");
	
	    for (var i = 0; i &lt; nodes.length; i++) {
	        var n = nodes.item(i);
	
	        var code = n.TextElement ? n.TextElement.value : "";
	        var text = n.TextElementText ? n.TextElementText.value : "";
	
	        switch (code) {
	            case "Z000": Z000 = text; break;
	            case "Z001": Z001 = text; break;
	            case "Z002": Z002 = text; break;
	            case "Z003": Z003 = text; break;
	            case "Z004": Z004 = text; break;
	        }
	    }
	
	    isLoaded = 1;  // tandai sudah load
	}
	
	
	// =======================================
	// Getter: Ambil salah satu
	// =======================================
	function get(code) {
	    loadTextElements();   // pastikan sudah load
	
	    switch (code) {
	        case "Z000": return Z000;
	        case "Z001": return Z001;
	        case "Z002": return Z002;
	        case "Z003": return Z003;
	        case "Z004": return Z004;
	        default: return "";
	    }
	}


// =======================================
// Getter all (kalau mau ambil semuanya)
// =======================================
function getAll() {
    loadTextElements();

    return {
        Z000: Z000,
        Z001: Z001,
        Z002: Z002,
        Z003: Z003,
        Z004: Z004
    };
}
	
	
	
	/*
	var isSet = 0;
	var z000Value = "";
	
	var isLoaded = 0;
	var map = {};   // dictionary untuk menyimpan seluruh kode (Z001, Z002, Z003, ...)
	
	function loadTextElements() {
	    if (isLoaded === 1) return;
	
	    var nodes = xfa.resolveNodes("$record.BillingDocumentNode.TextElements.TextElementNode[*]");
	
	    for (var i = 0; i &lt; nodes.length; i++) {
	        var n = nodes.item(i);
	        var code = n.TextElement ? n.TextElement.value : "";
	        var text = n.TextElementText ? n.TextElementText.value : "";
	
	        if (code !== "") {
	            map[code] = text;  // simpan key-value
	        }
	    }
	
	    isLoaded = 1;
	}
	
	// Fungsi generik ambil nilai
	function getText(code) {
	    loadTextElements();              // pastikan sudah di-cache
	    return map[code] ? map[code] : "";
	}
	*/
</script>
