<?xml version="1.0" encoding="utf-8"?>
<xs:schema elementFormDefault="qualified"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="Form">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="HeaderNode">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="CommercialInvoice" type="xs:string" minOccurs="0" />
                            <xs:element name="CommercialInvoiceDate" type="xs:date" minOccurs="0" />
                            <xs:element name="Container" type="xs:string" minOccurs="0" />
                            <xs:element name="ConSealTara" type="xs:string" minOccurs="0" />
                            <xs:element name="ponumber" type="xs:string" minOccurs="0" />

                            <xs:element name="soldname" type="xs:string" minOccurs="0" />
                            <xs:element name="soldprefix1" type="xs:string" minOccurs="0" />
                            <xs:element name="soldprefix2" type="xs:string" minOccurs="0" />
                            <xs:element name="soldstreet" type="xs:string" minOccurs="0" />
                            <xs:element name="soldpsuffix1" type="xs:string" minOccurs="0" />
                            <xs:element name="soldpsuffix2" type="xs:string" minOccurs="0" />
                            <xs:element name="soldpostal" type="xs:string" minOccurs="0" />
                            <xs:element name="soldcity" type="xs:string" minOccurs="0" />
                            <xs:element name="soldcountry" type="xs:string" minOccurs="0" />
                            <xs:element name="soldphone" type="xs:string" minOccurs="0" />
                            <xs:element name="soldfax" type="xs:string" minOccurs="0" />
                            <xs:element name="soldattn" type="xs:string" minOccurs="0" />

                            <xs:element name="shipname" type="xs:string" minOccurs="0" />
                            <xs:element name="shipprefix1" type="xs:string" minOccurs="0" />
                            <xs:element name="shipprefix2" type="xs:string" minOccurs="0" />
                            <xs:element name="shipstreet" type="xs:string" minOccurs="0" />
                            <xs:element name="shippsuffix1" type="xs:string" minOccurs="0" />
                            <xs:element name="shippsuffix2" type="xs:string" minOccurs="0" />
                            <xs:element name="shippostal" type="xs:string" minOccurs="0" />
                            <xs:element name="shipcity" type="xs:string" minOccurs="0" />
                            <xs:element name="shipcountry" type="xs:string" minOccurs="0" />
                            <xs:element name="shipphone" type="xs:string" minOccurs="0" />
                            <xs:element name="shipfax" type="xs:string" minOccurs="0" />
                            <xs:element name="shipattn" type="xs:string" minOccurs="0" />

                            <xs:element name="currency" type="xs:string" minOccurs="0" />
                            <xs:element name="shipterms" type="xs:string" minOccurs="0" />
                            <xs:element name="payterms" type="xs:string" minOccurs="0" />
                            <xs:element name="headernote" type="xs:string" minOccurs="0" />
                            <xs:element name="footernote" type="xs:string" minOccurs="0" />
                            <xs:element name="footernotepl" type="xs:string" minOccurs="0" />

                            <xs:element name="ItemNode" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Item" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="NoPO" type="xs:string" minOccurs="0" />
                                                    <xs:element name="Delivery" type="xs:decimal" minOccurs="0" />
                                                    <xs:element name="ConSealTara" type="xs:string" minOccurs="0" />
                                                    <xs:element name="totalqtycarton" type="xs:decimal" minOccurs="0" />
                                                    <xs:element name="totalgrossweight" type="xs:decimal" minOccurs="0" />
                                                    <xs:element name="totalnetweight" type="xs:decimal" minOccurs="0" />
                                                    <xs:element name="DetailItemNode" minOccurs="0">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="DetailItem" maxOccurs="unbounded" minOccurs="0">
                                                                    <xs:complexType>
                                                                        <xs:sequence>
                                                                            <xs:element name="NoItems" type="xs:integer" minOccurs="0" />
                                                                            <xs:element name="qtyincarton" type="xs:decimal" minOccurs="0" />
                                                                            <xs:element name="product" type="xs:string" minOccurs="0" />
                                                                            <xs:element name="productdesc" type="xs:string" minOccurs="0" />
                                                                            <xs:element name="packing" type="xs:string" minOccurs="0" />
                                                                            <xs:element name="grossweight" type="xs:decimal" minOccurs="0" />
                                                                            <xs:element name="netweight" type="xs:decimal" minOccurs="0" />
                                                                        </xs:sequence>
                                                                    </xs:complexType>
                                                                </xs:element>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>